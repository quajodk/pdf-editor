# Copy to .env for local development.

# Port the Express server listens on. Fly.io / Cloud Run override this at
# runtime; you generally do not need to set it in production.
PORT=3001

# Comma-separated list of allowed CORS origins. Leave unset in development
# (the server falls back to "*"); set to your Cloudflare Pages URL in prod.
# CORS_ORIGINS=https://your-frontend.pages.dev,https://example.com
